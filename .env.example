# LawPilot AI - Environment Configuration Example
# Copy this file to .env and insert your real API key (if available).
# If no key is set, LawPilot AI runs smoothly in Deterministic Demo Mode.

# LLM Provider Configuration
# Choose one of: 'demo', 'gemini', 'openai', 'anthropic'
LLM_PROVIDER=demo

# API Keys (Optional - only required if LLM_PROVIDER is not 'demo')
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# Legal Knowledge Base Cache
ENABLE_LEGAL_CACHE=true
